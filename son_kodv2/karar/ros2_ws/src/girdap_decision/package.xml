<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>girdap_decision</name>
  <version>0.1.0</version>
  <description>
    Girdap İDA — karar/planlama paketi: iSAM2 sensör füzyonu, RRT* global
    planlayıcı, MPPI lokal planlayıcı, görev FSM ve telemetri logger'ı.
    TEKNOFEST 2026 İnsansız Deniz Aracı yarışması.
  </description>
  <maintainer email="unszside@gmail.com">Girdap Takımı</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>mavros_msgs</depend>
  <depend>visualization_msgs</depend>
  <!-- Detection2DArray/Detection3DArray — perception_camera_node,
       perception_fusion_node ve planning_node (kapı takibi) kullanır.
       2026-08-03: kodda kullanılıyordu ama burada BEYAN EDİLMEMİŞTİ
       (temiz bir ortamda rosdep bağımlılığı kuramaz). -->
  <depend>vision_msgs</depend>

  <!-- 🔴 md 4.2 TESLİM ZİNCİRİ — kodda KULLANILIYORDU, beyan EDİLMEMİŞTİ.
       Temiz bir Jetson'da `rosdep install` bunları çekmez ve teslim
       node'ları AÇILIŞTA import hatasıyla ölür; belirti de vermez, yalnız
       o koşumun Dosya-1b/Dosya-3'ü hiç üretilmez (5+5 ceza).
       Aynı hata `vision_msgs` için 03.08'de yaşanmıştı (GIRDAP_DURUM §0.0b/3).
         · python3-opencv → Mp4Yazici (prototype/mapping/bev_renderer.py)
         · python3-pil    → BevRenderer + LocalMapDumper (PNG/çizim) -->
  <depend>python3-opencv</depend>
  <depend>python3-pil</depend>

  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

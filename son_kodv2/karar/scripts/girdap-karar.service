# GİRDAP İDA — karar yığını systemd servisi (Jetson açılışında otomatik başlar)
# Video/yarışma günü: güç ver → Jetson boot → yığın kendiliğinden ayakta;
# operatör yalnız **Mission Planner** kullanır (Write → ARM → GUIDED = görev
# başlar). [YKİ yazılımı 2026-08-03'te Mission Planner olarak kesinleşti.]
#
# 🔴 YARIŞMA GÜNÜ: bu servise ek olarak `girdap-karar-yarisma.conf` drop-in'i
#    kurulacak (ROS_LOCALHOST_ONLY=1 — şartname md 4.1 + LiDAR ethernet hattını
#    temiz tutma). Kurulum/geri alma o dosyanın başında yazılı.
#
# Kurulum — TERCIH EDILEN YOL: `bash scripts/jetson_kur_karar.sh`. Betik bu
# sablonu OKUMAZ, birimi kendi uretir ve PYTHONPATH'i paket dizininden geriye
# giderek HESAPLAR (yerlesim degisse de tutar). Asagidaki elle yol yalniz
# betigin kosamadigi durumlar icindir; ucuncu ikame (__KARAR__) SART:
#   sudo cp ~/ros2_ws/src/girdap_decision/scripts/girdap-karar.service /etc/systemd/system/
#   sudo sed -i "s|__USER__|$USER|g; s|__WS__|$HOME/ros2_ws|g; \
#                s|__KARAR__|$HOME/IDA_GIT/son_kodv2/karar|g" \
#        /etc/systemd/system/girdap-karar.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now girdap-karar
# Log izle:  journalctl -fu girdap-karar
# Durdur (masa testinde elle koşmak için):  sudo systemctl stop girdap-karar
# Tamamen kapat (bir daha açılışta başlamasın): sudo systemctl disable girdap-karar

[Unit]
Description=GIRDAP IDA karar yigini (mavros + FSM + planning + telemetri, mission_source=fc)
After=network.target
# md 4.2: saat, teslim node'lari dosya adlarini uretmeden ONCE dogru olmali
# (telemetry/local_map/lidar_kayit oturum adini BASLANGICTA uretiyor; saat
# sonradan duzelse bile dosya adlari yanlis kalir). Kurulum: girdap-saat.service
# Wants (Requires DEGIL): saat kurulamazsa gorev YINE baslamali — gorev
# baslamazsa hic puan yok. O durumda teslimler saat_guvenilir=false damgalanir.
After=girdap-saat.service
Wants=girdap-saat.service
# 🔴 11.08.2026 EKLENDI — LiDAR bagimliligi TEK YONLU kurulmustu.
# girdap-livox.service icinde `Before=girdap-karar.service` vardi; `Before=`
# yalniz SIRA kurar, BAGIMLILIK kurmaz (man systemd.unit). Yani livox unit'i
# `enable` edilmemisse ya da hic kurulmamissa karar yigini yine de kalkiyordu:
# /livox/lidar hic akmaz -> perception_lidar_node bos -> obstacle_map bos ->
# perception_fusion_node'un ApproximateTimeSynchronizer'i tetiklenmez ->
# classified_obstacles yayinlanmaz -> planning_node._edge_buoys bos ->
# select_gate None -> KAPI SAYISI YAPISAL OLARAK SIFIR (§0.30e). Tekne
# sessizce ham gorev noktasina surer, tek satir hata basilmaz.
# Wants (Requires DEGIL) bilincli: LiDAR olse bile gorev BASLAMALI — gorev
# baslamazsa hic puan yok. Ayni gerekce girdap-saat.service'te de gecerli.
After=girdap-livox.service
Wants=girdap-livox.service
# 🔴 ALGI da ayni sekilde: /perception/buoys'un TEK ureticisi girdap-algi.
# hardware.launch.py algiyi HIC acmiyor (use_onboard_camera varsayilani false,
# perception_camera_node IfCondition ile kapali) — yani HSV yedek kolu da yok.
# Servis kurulmamissa yukaridaki zincir kirilir, belirti vermez.
After=girdap-algi.service
Wants=girdap-algi.service

[Service]
Type=simple
User=__USER__
# KAR-09: karar yigini kayit/arka plan islerinden ONCE kosmali. RT politikasi
# DEGIL bilincli bir tercih (bkz. girdap-rosbag.service'teki gerekce) —
# negatif nice, oncelik verir ama aclik (starvation) uretmez.
Nice=-5
# F2.3: prototype/* importlari icin PYTHONPATH sart (systemd .bashrc okumaz).
#
# 🔴 12.08.2026 — YER TUTUCU DUZELTILDI. Burada `__WS__/src/girdap-decision`
# yaziyordu ve IKI KEZ yanlisti: (1) `__WS__` = colcon workspace'i
# (`$HOME/ros2_ws`), ama `prototype/*` orada DEGIL, karar kokunde yasiyor;
# (2) dizin adi TIRE ile yazilmis, gercek symlink ALT CIZGI
# (`ros2_ws/src/girdap_decision`) — yani uretilen yol hic var olmuyordu.
# Bu satirla kurulan bir birim her `import prototype...`'ta patlardi.
# Fark edilmemesinin sebebi: jetson_kur_karar.sh birimi KENDI uretiyor ve
# yolu paket dizininden geriye giderek hesapliyor, yani bu sablonu hic
# okumuyor. Elle kurulum yapan biri icin tuzak olarak duruyordu.
# `__KARAR__` adlandirmasi girdap-rosbag.service ile ayni (11.08 dersi).
Environment=PYTHONPATH=__KARAR__
# Interaktif terminallerle ayni DDS domain'i (bashrc ROS_DOMAIN_ID=42) —
# yoksa operator `ros2 topic echo` ile servisi GOREMEZ (2026-07-13 bulgusu).
# NOT: DOMAIN_ID tek basina trafigi makineye HAPSETMEZ, yalnizca ayni domain'i
# kullananlari birbirinden ayirir. Ag izolasyonu icin ROS_LOCALHOST_ONLY gerekir
# ve o bilincli olarak BURADA DEGIL, yarisma drop-in'inde (yukariya bkz.).
Environment=ROS_DOMAIN_ID=42
# F4.1/F15.1 dersi: cwd=/ olmasin — goreli yol kazalarina karsi HOME'dan kos.
WorkingDirectory=/home/__USER__
# 🔴🔴 §0.42 (11.08 akşam, ÖLÇÜLDÜ) — ÇİFT YIĞIN KORUMASI.
# `girdap-karar` altında AYNI ANDA İKİ TAM YIĞIN koştu (eski PID 2054, yeni
# 2583). Yeni yığının tüm ağacı 20 dakika tek satır log basmadı; eski yığın
# ölüp de canlanınca BEŞ BEKÇİ aynı saniyede ~1195 s bayatlık ölçtü →
# `FAILSAFE — heartbeat kaybı (1195.6s)` → FSM KILL → F-M.3 köprüsü FC'yi
# DISARM etti. Kaptan "GUIDED'a çektim hâlâ KILL attı" dedi; ölçüm KILL'in
# GUIDED'dan **3 dakika ÖNCE** attığını gösterdi (16:05:17 ↔ 16:08:38).
# Yani o akşamki GUIDED testi bu yüzden boşa gitti.
#
# Kaptanın kuralı: *"`systemctl restart` eski yığını her zaman düşürmüyor —
# restart sonrası `pgrep -af hardware.launch.py` TEK satır vermeli."*
# Kural artık elle denetlenmiyor, servis kendi zorluyor:
#
#   ExecStartPre  → başlamadan ÖNCE kalıntı yığını kesin olarak düşür.
#                   `-` öneki: kalıntı yoksa pkill 1 döner, başlatmayı
#                   engellemesin diye hata yok sayılır.
#   KillMode      → varsayılan zaten control-group ama AÇIKÇA yazılıyor:
#                   `ros2 launch` çocuklarını her zaman düzgün toplamıyor.
#   TimeoutStopSec→ süre dolunca cgroup'un tamamına SIGKILL (yoksa yavaş
#                   kapanan bir düğüm kalıntı yığının ta kendisi olur).
#
# Çalışma zamanı ikinci katmanı: fsm_node `count_publishers` ile
# /girdap/mission/state üzerinde birden fazla yayıncı görürse bağırır
# (KAR-01) — servis kaçırırsa orada yakalanır.
# 🔴 DESEN BAŞA SABİTLENMİŞ OLMALI — 12.08'de CANLI olarak öğrenildi.
# İlk yazımım `-f "hardware\.launch\.py"` idi. `-f` TÜM KOMUT SATIRINDA
# arattığı için o metni içeren HER SÜREÇ eşleşiyordu: operatörün kabuğu,
# `grep`, editör — ve testi yapan ssh oturumumun kendisi. Denerken kendi
# bağlantımı SIGKILL ile düşürdü. Bir "temizlik" komutunun masum süreçleri
# öldürmesi, temizlediği arızadan daha kötüdür.
# `^/usr/bin/python3 …` sabitlemesi yalnız GERÇEK launch sürecini yakalar;
# kabukların komut satırı "bash -c …" ile başladığı için kapsam dışında kalır.
#
# ⚠ SINIR: ExecStartPre `User=` ile koşar, yani BAŞKA bir kullanıcının
# (ör. sudo ile elle başlatılmış) yığınını öldüremez. Gerçek olayda iki
# yığın da aynı kullanıcıdaydı; kural bu senaryoyu kapsıyor. Root olarak
# elle launch eden biri hâlâ ikinci yığın yaratabilir — orada ikinci
# katman devreye girer (fsm_node'un çift yayıncı denetimi, KAR-01).
ExecStartPre=-/usr/bin/pkill -9 -f "^/usr/bin/python3 [^ ]*/ros2 launch girdap_decision"
ExecStartPre=/bin/sleep 2
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash && source __WS__/install/setup.bash && exec ros2 launch girdap_decision hardware.launch.py mission_source:=fc'
KillMode=control-group
TimeoutStopSec=30
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target

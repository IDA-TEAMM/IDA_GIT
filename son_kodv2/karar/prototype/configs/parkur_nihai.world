<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="ida_yarismasi_parkuru">

    <!-- GUNES -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <!-- DENIZ -->
    <model name="ocean">
      <static>true</static>

      <link name="water">
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>250 250</size>
            </plane>
          </geometry>

          <material>
            <ambient>0 0.2 0.8 1</ambient>
            <diffuse>0 0.2 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>


    <!-- ========================= -->

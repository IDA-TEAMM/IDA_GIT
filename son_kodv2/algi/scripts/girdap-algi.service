# GİRDAP İDA — algı node'u systemd servisi (Jetson açılışında otomatik başlar)
# Kurulum: jetson_kur.sh --servis  (__USER__/__WS__ yer tutucularını doldurur)
# El ile:  sudo cp scripts/girdap-algi.service /etc/systemd/system/
#          sudo sed -i "s|__USER__|$USER|g; s|__WS__|$HOME/ros2_ws|g" /etc/systemd/system/girdap-algi.service
#          sudo systemctl daemon-reload && sudo systemctl enable --now girdap-algi
# Log:     journalctl -fu girdap-algi
# Durdur:  sudo systemctl stop girdap-algi   (saha müdahalesi / Plan B'ye geçiş)

[Unit]
Description=GIRDAP IDA algi node (OAK-D Lite YOLO + gecit)
After=network.target
# Emniyet kemeri: tek OAK var, iki surec acamaz. systemd'de Conflicts= CIFT
# YONLUDUR (man systemd.unit: "starting the former will stop the latter and
# vice versa"), yani veriseti unit'indeki satir teknik olarak yeter — ama o
# ancak IKI unit de KURULUYSA isler. Burada da acikca yaziyoruz ki bu dosya
# tek basina okundugunda kisit gorunur olsun.
# 🔴 YARISMA GUNU: `sudo systemctl disable --now girdap-veriseti` (md 4.1).
#   Ikisi de enabled kalirsa boot'ta yaris olur, hangisinin kazandigi belirsiz.
Conflicts=girdap-veriseti.service

[Service]
Type=simple
User=__USER__
# 🔴 SART — 2026-08-05'te veri seti servisi TAM BURADAN COKTU, ayni hata bu
# dosyada 07.08'e kadar duruyordu: depthai onbellegini/telemetrisini CALISMA
# DIZININE GORELI yaziyor (`.cache/depthai/...`). WorkingDirectory verilmezse
# systemd cwd'yi `/` yapar (man systemd.exec: "defaults to the root directory
# when systemd is running as a system instance") → depthai `/.cache` yaratmaya
# calisir → "Permission denied" → pipeline HIC acilmaz. Belirti kameraymis gibi
# gorunur. Elle calistirinca cwd ev dizini oldugu icin sorun GORUNMEZ — yalniz
# boot'ta/servis olarak coker. Duzeltme veri setinde `a622c3f`.
WorkingDirectory=/home/__USER__
Environment=HOME=/home/__USER__
# 🔴🔴 SART — 2026-08-10 bulgusu: karar yigininin servisi
# `Environment=ROS_DOMAIN_ID=42` ile kosuyor (son_kodv2/karar/scripts/
# girdap-karar.service), bizde bu satir YOKTU => varsayilan domain 0.
# Iki taraf FARKLI DDS domain'inde kalkar, ikisi de "calisiyor" gorunur ama
# BIRBIRINI HIC GORMEZ: /perception/buoys yayinlanir, fuzyon dinler, bulusmazlar
# => tum LiDAR kumeleri CLASS_UNKNOWN => gate_follower ham GPS'e duser =>
# P1 (G1/KD1>=0,5) ve P2 (>=2 ikili) GIDER, tek satir hata basilmadan.
# `bash -lc` bunu KURTARMAZ: Ubuntu'nun ~/.bashrc'si etkilesimsiz kabukta ilk
# satirda `return` eder (karar tarafi ayni dersi 2026-07-13'te yasamis ve kendi
# servisine ayni satiri yazmis: "systemd .bashrc okumaz").
# ⚠️ Deger karar tarafiyla AYNI olmak zorunda — onlar degistirirse burasi da degisir.
Environment=ROS_DOMAIN_ID=42
# Login shell: ROS + workspace ortamini yukle, launch'i kostur.
# Launch respawn'li - node cokerse launch toparlar; launch'in kendisi cokerse
# systemd 10 sn sonra yeniden dener.
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash && source __WS__/install/setup.bash && exec ros2 launch girdap_ida_algi algi.launch.py'
Restart=on-failure
RestartSec=10
# 🔴 StartLimit BILEREK YOK — veriseti unit'inde `StartLimitBurst=5/300 sn` var,
# BURAYA KOPYALANMADI. Oradaki amac "kamera hic takili degilse journal sismesin";
# burada ayni ayar 5 denemeden sonra algiyi KALICI olarak oldururdu ve yaris
# ortasinda gecici bir USB kopmasi tum puani goturebilirdi (P1 G1/KD1, P2 G2/KD2).
# RestartSec=10 dongunun hizini zaten kesiyor: journal 10 sn'de bir satir yazar.
# Sonsuz yeniden deneme burada DOGRU davranis.

[Install]
WantedBy=multi-user.target

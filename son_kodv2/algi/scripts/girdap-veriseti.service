# GİRDAP İDA — YOLO VERİ SETİ TOPLAYICI servisi (DENİZ OTURUMU, PC/EKRAN YOK)
#
# NEDEN VAR: veri seti denizde toplanacak ve orada dizüstüyle bağlanamayacağız.
# Elle komut çalıştıramayacağımıza göre toplayıcı AÇILIŞTA kendi başına
# başlamalı; yoksa tekne suya girer, kimse fark etmeden tek kare toplanmadan
# geri döner ve o oturum bir daha kurulamaz.
#
# 🔴 2026-08-05 DURUM TESPİTİ (ölçüldü, tahmin değil):
#   /etc/systemd/system/girdap-veriseti.service DOSYASI VAR ama
#   (a) `systemctl is-enabled` = **disabled** → AÇILIŞTA BAŞLAMIYOR,
#   (b) kurulu kopya BU dosya değil; 04.08 19:30'daki ESKİ sürüm ve
#       ~/oak_veriseti_topla.py'yi (git dışı, **manifest.csv'siz**) çağırıyor.
#   ⇒ Bugün denize girilse tek kare toplanmazdı. Aşağıdaki kurulum ŞART.
#
# Kurulum (kurulu ESKİ kopyanın ÜZERİNE yazar):
#   sudo cp scripts/girdap-veriseti.service /etc/systemd/system/
#   sudo sed -i "s|__USER__|$USER|g; s|__WS__|$HOME/ros2_ws|g" \
#        /etc/systemd/system/girdap-veriseti.service
#   sudo systemctl daemon-reload
#
# 🔴 VERİ SETİ GÜNÜ (tek OAK var, iki süreç açamaz — kıyıda, denize girmeden):
#   sudo systemctl enable --now girdap-veriseti
#   # OAK'ı başka süreç tutuyor mu, DOĞRULA (algı/karar yığını kamerayı açarsa
#   # toplayıcı hiç kare alamaz; `girdap-algi.service` bu makinede YOK, o yüzden
#   # Conflicts= tek başına yetmez):
#   lsusb | grep 03e7        # 03e7:2485 = bootloader, yani cihaz BOŞTA
#   ps aux | grep -iE "oakd|perception_camera|depthai" | grep -v grep
# 🔴 YARIŞMA/TEST GÜNÜ (geri al):
#   sudo systemctl disable --now girdap-veriseti
#
# Doğrulama (kıyıda, denize girmeden ÖNCE — zorunlu, ATLANAMAZ):
#   docs/veriseti_deniz_oturumu.md kontrol listesi
#   journalctl -fu girdap-veriseti      # "[+] N kare" satırları akmalı
#   ls ~/girdap_veriseti/images | wc -l # sayı ARTMALI
#   sudo reboot && (boot sonrası) systemctl is-active girdap-veriseti
#                                 # "enable ettim" ≠ "boot'ta başladı"

[Unit]
Description=GIRDAP IDA veri seti toplayici (OAK-D Lite, ekransiz)
After=network.target
# Emniyet kemeri: ikisi aynı anda AÇILAMAZ. Tek OAK'ı iki süreç açamaz;
# çakışırsa kamera tamamen ölür ve sahada belirti vermez.
# ⚠ 2026-08-05 ÖLÇÜMÜ: bu makinede `girdap-algi.service` diye bir unit YOK
#   (yalnız girdap-karar.service var, enabled+active). Yani bu satır bugün
#   hiçbir şeyi engellemiyor — gerçek koruma kıyı kontrol listesindeki
#   "OAK'ı tutan süreç var mı" adımı (docs/veriseti_deniz_oturumu.md).
Conflicts=girdap-algi.service
# Kamera hiç takılı değilse script exit(1) verir; sonsuz döngü yerine 300 sn
# penceresinde 5 denemeden sonra pes et (journal şişmesin).
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=__USER__
# 🔴 ŞART — 2026-08-05'te servis TAM BURADAN ÇÖKTÜ:
# depthai önbelleğini/telemetrisini ÇALIŞMA DİZİNİNE GÖRELİ yazıyor
# (`.cache/depthai/...`). WorkingDirectory verilmezse systemd cwd'yi `/` yapar →
# depthai `/.cache` yaratmaya çalışır → "Permission denied" → pipeline HİÇ
# açılmaz, tek kare toplanmaz. Belirti kameraymış gibi görünür ("pipeline
# başlatılamadı"), oysa sebep izin. Elle çalıştırınca cwd ev dizini olduğu
# için sorun GÖRÜNMEZ — yalnız servis olarak çökerdi.
WorkingDirectory=/home/__USER__
Environment=HOME=/home/__USER__
# --no-preview: ekran yok (cv2.imshow çağrılmaz); toplayıcıda otomatik modu
#     ZORLAR (oak_veriseti_topla.py:325 `auto = headless or args.auto_start`).
#     --auto-start yine de açıkça veriliyor: niyet kodun içine gömülü kalmasın.
# --cihaz-bekle 3600: boot'ta USB geç enumere olabilir / kamera sonradan
#     takılabilir. Sahada monitör ve SSH YOK → "bulamadım, pes ettim" sessiz
#     başarısızlığı kabul edilemez, 1 saat bekle.
# 🔴 2026-08-05 AKŞAMI DEĞİŞTİ (Eyüp: "fotoğraf çok hızlı çekiyor, kalıcı
#     düşürelim, farklı farklı fotoğraflar olmalı"):
#       --fps 15 → 10 · --interval 1.0 → 2.0 · --zorunlu-aralik 5 → 10
#     `--min-fark` BİLEREK 0.5'te BIRAKILDI — yükseltmek en doğrudan çözüm gibi
#     görünür ama filtrenin uzak dubaya körlüğünü geri getirir (aşağıya bak).
#     Hız yerine ARALIK düşürüldü: kareler arası mesafe artar, çeşitlilik artar.
#
# --interval 2.0: 2 sn'de en fazla 1 kare = kare başına ~3 m yol (1,5 m/s'te).
#     15 m'den 2 m'ye yaklaşma ~9 sn sürer → aynı duba ~4-5 farklı mesafede
#     yakalanır. (1.0'da ~9 kare oluyordu ama ardışıklar birbirine çok benziyordu;
#     mesafe çeşitliliği kare SAYISINDAN değil kareler arası MESAFEDEN geliyor.)
#     🔴 Bundan daha fazla büyütme: 3.0'da yaklaşma başına ~3 kare kalır, uzak
#     mesafe bandı (8-15 m) temsilsiz kalabilir — model orayı öğrenemez.
# --min-fark 0.5 (2.0 DEĞİL): 🔴 2026-08-05 hesabı — filtre TÜM karenin ortalama
#     farkına bakıyor; 10 m'deki 30 cm duba ortalamaya yalnız 0,11 katıyor.
#     Eşik 2,0 iken uzaktaki duba kadraja girdiğinde kare ELENİYORDU.
# --zorunlu-aralik 10: KALP ATIŞI — 10 sn'dir hiç kayıt yoksa filtreyi aş.
#     Bu bir SİGORTA: filtre uzak dubaya kör (yukarı bak), o yüzden "hiç kare
#     almama" hâli imkânsız kılınıyor. 5 → 10 yapıldı çünkü tekne dururken
#     (kıyı/bekleme) kalp atışı tek başına aynı kareyi üretip duruyordu.
#     🔴 Daha fazla büyütme: 1,5 m/s'te 10 sn = 15 m yol; sigortanın koruduğu
#     senaryo tam bu mesafede (uzak duba kadraja girer, filtre eler). 15-20 sn
#     yapılırsa sigorta işlevini kaybeder.
#     BİLEREK BOL TOPLA: fazla kareyi atmak kolay, kaçan oturum geri gelmez.
#     Ölçülen boyut ~0,25 MB/kare → ~0,45 GB/saat; diskte 418 GB boş.
# --fps 10 (2026-08-05 akşamı 15'ten indirildi): akış 23,3 MB/s.
#     🔴 GEREKÇE DEĞİŞTİ: USB3 bu Jetson'da kararsız olduğu için artık USB2'ye
#     BİLEREK zorluyoruz (girdap_ida_algi/oak_baglanti.py) — yani USB2 bir
#     yedek senaryo değil, KALICI durum. 15 fps = 35,0 MB/s, USB2'nin pratik
#     tavanının (~35-40) tam kenarı, pay yok. Üstelik `lsusb -t`: OAK ile
#     telefon tethering'i AYNI 480 Mbps hattını paylaşıyor. 20 fps (46,7 MB/s)
#     USB2'de ÇÖKTÜĞÜ ölçüldü. Kaydı --interval yönettiği için 10↔15 farkı
#     veri setine YANSIMIYOR — sadece USB yükü ve ısı azalıyor.
#     Toplayıcı USB hızını + VPU sıcaklığını açılışta journal'a yazar.
# --min-bos-gb 10: disk dolmadan TEMİZ dur (exit 0 → systemd yeniden başlatmaz).
# 🔴 --res 1352x1014 (11.08'de 1440x1080'den AÇIKÇA yazıldı): toplayıcı zaten
#     1440x1080'i sessizce buna düşürüyordu (THE_1440X1080 sensör modu bu
#     cihazda HİÇ kare üretmiyor), yani davranış değişmedi — niyet görünür oldu.
#     512x512 TOPLAMA REDDEDİLDİ (Eyüp sordu, ölçüldü): kamera aynı anda iki
#     çıkış veriyor — `isp` 1352x1014 (arşiv) ve `preview` 512x512 (NN). 512
#     her zaman 1352'den türetilir, TERSİ ASLA. Ölçüm: 20+ m'deki duba 1352'de
#     14,8 px / 240 piksel, 512'de 5,6 px / 48 piksel. Renk kaybolmuyor (ton
#     kayması medyan 0,3°, sınır 21° uzakta) ama ELLE ETİKETLEMEDE 1 px'lik el
#     hatası 512'de kutunun %18'i (1352'de %6,8) ve menzil yedeği bbox
#     genişliğinden hesapladığı için bu doğrudan %18 mesafe hatası = 20 m'de
#     3,6 m. Yer kazancı sıfıra yakın: 4.000 kare ~0,92 GB, diskte 418 GB.
ExecStart=/bin/bash -lc 'exec python3 __WS__/src/girdap-ida-algi/scripts/oak_veriseti_topla.py \
    --no-preview --auto-start --out ~/girdap_veriseti \
    --res 1352x1014 --fps 10 --interval 2.0 --min-fark 0.5 --zorunlu-aralik 10 \
    --min-bos-gb 10 --cihaz-bekle 3600'
# on-failure: kamera kopması/çökme → yeniden dene (indeks kaldığı yerden devam
# eder, manifest EKLEMELİ yazılır). Sınıra/diske takılıp temiz çıkarsa (exit 0)
# yeniden başlatmaz — sonsuz döngü olmasın.
# 🔴🔴 KAPANIŞ SÖZLEŞMESİ — 2026-08-11'de ÖLÇÜLDÜ, kod düzeltildi
# Python'un SIGTERM varsayılanı süreci ANINDA öldürür, `finally` bloğu ÇALIŞMAZ
# (gerçek süreçle doğrulandı; SIGINT'te çalışıyor, SIGTERM'de çalışmıyordu).
# rclpy de yalnız SIGINT'e işleyici kuruyor, SIGTERM'e DOKUNMUYOR.
# systemd `stop` / `reboot` / güç düğmesi **SIGTERM** gönderir.
# Kodda artık SIGTERM→KeyboardInterrupt çevrimi VAR; buradaki iki satır ONUN
# YEDEĞİ ve ayrıca kapanışa ZAMAN tanır — işleyici olsa bile systemd varsayılanı
# 90 sn'dir ama biz açıkça yazıyoruz ki dosya tek başına okunduğunda görünsün.
# KillSignal=SIGINT: iki yoldan da (işleyici + sinyal) temiz kapanış.
# SendSIGKILL=yes: temiz kapanış tıkanırsa süreç yine de ölsün, boot asılmasın.
KillSignal=SIGINT
TimeoutStopSec=20
SendSIGKILL=yes
# Kapanmazsa: `dev.close()` calismaz, OAK KIRLI kapanir -> sonraki acilista
# USB takilma riski, sahada fiziksel erisim YOK.
Restart=on-failure
RestartSec=10
# Ekransız çalışıyor → tek görünürlük journal. `journalctl -fu girdap-veriseti`
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

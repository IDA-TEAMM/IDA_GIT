<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>girdap_ida_algi</name>
  <version>0.1.0</version>
  <description>GIRDAP IDA - duba algilama ve gecit gorev mantigi (TEKNOFEST 2026 Insansiz Deniz Araci)</description>
  <maintainer email="girdap@example.com">Team GIRDAP</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <!-- node bunları da import ediyor; listelenmezse temiz makinede rosdep
       eksik kurar ve node ilk import'ta ölür (2026-08-04 entegrasyon
       taramasında bulundu) -->
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>vision_msgs</depend>
  <!-- Dosya-1 mp4 overlay'i (md 4.2) cv2 kullanıyor -->
  <exec_depend>python3-opencv</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
